# Discord bot token (from the Developer Portal). Used only to authenticate
# REST calls - the bot never needs to appear online. Treat as a secret.
DISCORD_TOKEN=

# The game server's ID. Enable Developer Mode in Discord, right-click the
# server icon, "Copy Server ID". The scraper reads every text channel in it.
DISCORD_GUILD_ID=

# Channels to skip (chatter, not night actions), matched by name,
# case-insensitive. Optional - this is the default if unset.
DISCORD_EXCLUDE_CHANNELS=general,dead-chat,dead,graveyard,spectators

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
